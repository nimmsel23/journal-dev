{
  "name": "@vos/journal",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "exports": {
    ".": "./src/db.js",
    "./views": "./src/views/JournalVosView.jsx",
    "./lib/db": "./src/lib/db/journal.js"
  },
  "description": "Journal VOS — Journal + Habit PWA auf fuel-dev Shell (Firestore via fitness-aos)",
  "scripts": {
    "dev": "VITE_APP_MODE=client vite --config vite.config.cjs",
    "build": "VITE_APP_MODE=client vite build --config vite.config.cjs",
    "preview": "vite preview --config vite.config.cjs",
    "build:firebase": "VITE_APP_MODE=client vite build --mode firebase --config vite.config.cjs",
    "build:cloud": "VITE_APP_MODE=client vite build --mode firebase --config vite.config.cjs",
    "deploy": "pnpm run build:cloud && firebase deploy --only hosting:journal --project fitness-aos",
    "deploy:cloud": "pnpm run build:cloud && firebase deploy --only hosting:journal --project fitness-aos",
    "deploy:v2:build": "VITE_APP_MODE=client VITE_DEFAULT_TAB=journal-v2 vite build --mode firebase --config vite.config.cjs --outDir dist-v2",
    "deploy:v2": "pnpm run deploy:v2:build && firebase deploy --only hosting:v2 --project fitness-aos",
    "deploy:door:build": "VITE_APP_MODE=client VITE_APP_FLAVOR=door VITE_DEFAULT_TAB=door-v2 vite build --mode firebase --config vite.config.cjs --outDir dist-door",
    "deploy:door": "pnpm run deploy:door:build && firebase deploy --only hosting:door --project fitness-aos",
    "deploy:preview": "pnpm run build:cloud && node scripts/deploy-preview.mjs",
    "release": "npm version patch --no-git-tag-version && pnpm run deploy:cloud",
    "firebase": "pnpm run deploy:cloud",
    "deploy:prev": "pnpm run deploy:preview",
    "build:preview": "pnpm run deploy:preview",
    "build:prev": "pnpm run deploy:preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@hookform/resolvers": "^3.9.0",
    "@noble/ciphers": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.59.0",
    "@vos/cross-app-aliases": "link:../vitalos/packages/cross-app-aliases",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "fastify": "^4.28.1",
    "firebase": "^11.0.1",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-window": "^7.4.1"
  }
}
