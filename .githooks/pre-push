#!/bin/bash
# pre-push: Reminder-only. Standalone-Live = CI auf master; Shell-Pin = vos-release/vos-ship.

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  if [ "${local_ref#refs/heads/}" = "dev" ]; then
    echo "💡 Release: dev → master (Auto-Promote / vos-release-pr journal); Shell-Pin mit journal-release / vos-ship. Doku: ~/vitalos/docs/DEPLOYMENT.md" >&2
    break
  fi
done

exit 0
