{
  "name": "@vos/habits",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "exports": {
    ".": "./src/db.js",
    "./views/Habits": "./src/views/Habits/index.jsx",
    "./lib/db": "./src/lib/db/habits.js",
    "./lib/core": "./src/lib/db/core.js"
  },
  "scripts": {
    "dev": "vite --config vite.config.cjs",
    "build": "node scripts/ensure-kb-data.mjs && vite build --config vite.config.cjs",
    "build:firebase": "node scripts/ensure-kb-data.mjs && VITE_APP_MODE=client vite build --config vite.config.cjs",
    "build:cloud": "node scripts/ensure-kb-data.mjs && VITE_APP_MODE=client vite build --config vite.config.cjs",
    "preview": "vite preview --config vite.config.cjs",
    "test": "node --test tests/*.test.mjs",
    "check:journal-build": "node scripts/check-journal-build.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "firebase": "^11.10.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
